#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"
export PATH="$(pwd -P)/.gitleaks-bin:$PATH"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "Gitleaks est requis. Voir la section Protection des secrets du README." >&2
  exit 1
fi

exec gitleaks git --config .gitleaks.toml --redact=100 --no-banner --no-color --verbose --ignore-gitleaks-allow "$@"
